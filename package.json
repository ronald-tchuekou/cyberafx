{
  "name": "cyberafx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' drizzle-kit migrate",
    "db:push": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' drizzle-kit push",
    "db:seed": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/features/signals/lib/stats.check.ts && tsx src/features/chart/lib/smc.check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.25",
    "@clerk/ui": "^1.42.4",
    "@hookform/resolvers": "^7.0.5",
    "@neondatabase/serverless": "^1.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "svix": "^2.10.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
